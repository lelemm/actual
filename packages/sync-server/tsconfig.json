{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "lib": ["ES2021"],
    "noEmit": false,
    "strict": false, // TODO: fix issues and remove this
    "strictFunctionTypes": true,
    "declaration": true,
    "declarationMap": true,
    "outDir": "build",
    "tsBuildInfoFile": "build/.tsbuildinfo",
    "paths": {
      "@actual-app/api": ["../api/index.ts"]
    },
    "plugins": [
      {
        "name": "typescript-strict-plugin",
        "paths": ["."]
      }
    ]
  },
  "references": [
    {
      "path": "../crdt"
    },
    {
      "path": "../desktop-client"
    },
    {
      "path": "../api"
    }
  ],
  "include": [
    "src/**/*",
    "migrations/**/*",
    "types/**/*",
    "app.ts",
    "bin/**/*"
  ],
  "exclude": ["node_modules", "build", "coverage"]
}
