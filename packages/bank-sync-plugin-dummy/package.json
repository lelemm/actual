{
  "name": "@actual-app/bank-sync-plugin-dummy",
  "version": "0.0.1",
  "private": true,
  "description": "Dummy bank sync plugin for validating the plugin MVP stack",
  "license": "MIT",
  "type": "module",
  "imports": {
    "#manifest": "./src/manifest.ts"
  },
  "scripts": {
    "build": "yarn clean && yarn build:compile && yarn build:manifest && yarn build:bundle && yarn build:frontend && yarn package:zip",
    "build:bundle": "node scripts/build-bundle.cjs",
    "build:compile": "tsc -b",
    "build:frontend": "vite build",
    "build:manifest": "node scripts/build-manifest.cjs",
    "build:zip": "yarn build",
    "clean": "rm -rf dist manifest.json",
    "install:sync-server": "node scripts/install-sync-server.cjs",
    "package:zip": "node scripts/build-zip.cjs"
  },
  "devDependencies": {
    "@actual-app/plugins-core": "workspace:*",
    "@actual-app/plugins-core-sync-server": "workspace:*",
    "@module-federation/vite": "^1.4.1",
    "@vitejs/plugin-react": "^6.0.2",
    "esbuild": "^0.28.1",
    "fflate": "^0.8.3",
    "i18next": "^26.3.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-i18next": "^17.0.8",
    "typescript": "^6.0.3",
    "vite": "^8.0.16"
  }
}
