#!/bin/bash

# Docker Plugin E2E Runner
# This script runs inside the Docker container and handles:
# 1. Starting the main Actual Budget app
# 2. Starting the test plugin server  
# 3. Running the e2e tests
# 4. Cleanup

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

echo -e "${BLUE}🐳 Starting Plugin E2E Tests in Docker${NC}"

# Install dependencies if needed
if [ ! -d "node_modules" ] || [ "$(ls -A node_modules)" = "" ]; then
    echo -e "${YELLOW}📦 Installing dependencies...${NC}"
    yarn install
fi

# Rebuild native dependencies for the Docker container's Node.js version
echo -e "${YELLOW}🔨 Rebuilding native dependencies...${NC}"
yarn rebuild-node

echo -e "${BLUE}🚀 Starting test plugin service...${NC}"

# Note: Sync server with embedded UI is running on host (localhost:5006)
echo -e "${YELLOW}ℹ️  Sync server with embedded UI expected at localhost:5006 (running on host)${NC}"

# Build and start the test plugin server in background  
echo -e "${YELLOW}Building test plugin...${NC}"
cd packages/test-plugin
yarn build
echo -e "${YELLOW}Starting test plugin server...${NC}"
# Use npx serve to serve the built files on port 2000
npx serve build -p 2000 > /tmp/test-plugin.log 2>&1 &
PLUGIN_PID=$!
cd ../..

# Function to cleanup processes
cleanup() {
    echo -e "\n${YELLOW}🧹 Cleaning up...${NC}"
    # Note: Sync server cleanup is handled by host script
    if [ ! -z "$PLUGIN_PID" ] && kill -0 $PLUGIN_PID 2>/dev/null; then
        echo "Stopping test plugin (PID: $PLUGIN_PID)"
        kill $PLUGIN_PID || true
    fi
    echo -e "${GREEN}✅ Cleanup completed${NC}"
}

# Set up trap for cleanup
trap cleanup EXIT INT TERM

# Check if sync server is accessible on host
echo -e "${YELLOW}🔍 Checking sync server accessibility...${NC}"
echo -n "Checking sync server (localhost:5006)..."
if curl -s http://localhost:5006 > /dev/null 2>&1; then
    echo -e " ${GREEN}✅${NC}"
else
    echo -e " ${RED}❌ Sync server not accessible${NC}"
    echo "Make sure the sync server container is running on the host"
    exit 1
fi

# Wait for test plugin (port 2000)  
echo -n "Waiting for test plugin (port 2000)..."
timeout=60  # 1 minute
while [ $timeout -gt 0 ]; do
    if curl -s http://localhost:2000 > /dev/null 2>&1; then
        echo -e " ${GREEN}✅${NC}"
        break
    fi
    echo -n "."
    sleep 1
    timeout=$((timeout - 1))
done

if [ $timeout -eq 0 ]; then
    echo -e " ${RED}❌ Failed to start test plugin${NC}"
    echo "Plugin logs:"
    tail -20 /tmp/test-plugin.log
    exit 1
fi

echo -e "${GREEN}🎉 All services are ready!${NC}"

# Test UI availability on sync server port with embedded UI
echo -n "Testing UI availability on port 5006..."
if curl -s http://localhost:5006/ | grep -q "html\|Actual\|<!DOCTYPE"; then
    echo -e " ${GREEN}✅${NC}"
else
    echo -e " ${RED}❌ UI not available on port 5006${NC}"
    echo "Port 5006 response:"
    curl -s http://localhost:5006/ | head -5
    exit 1
fi

# Run the e2e tests against the sync server on localhost:5006
echo -e "${BLUE}🧪 Running e2e tests against localhost:5006...${NC}"
E2E_START_URL=http://localhost:5006 yarn workspace @actual-app/plugins-core test:e2e:docker "$@"

TEST_EXIT_CODE=$?

if [ $TEST_EXIT_CODE -eq 0 ]; then
    echo -e "${GREEN}🎉 All tests passed!${NC}"
else
    echo -e "${RED}❌ Some tests failed${NC}"
fi

exit $TEST_EXIT_CODE 